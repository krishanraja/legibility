# Legibility environment. Copy to .env and fill in. NEVER commit .env (gitignored).

# --- Client + SSR (public, RLS-gated; safe to expose) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# --- Server-only secrets (set in Vercel project env, never in the client bundle) ---
# SUPABASE_SERVICE_ROLE_KEY="..."        # writes to usage_events/resolutions/product_cache; bypasses RLS
# LEGIBILITY_EXTRACTOR_URL="https://..."     # standalone extraction worker (Phase 1)
# LEGIBILITY_EXTRACTOR_TOKEN="..."           # worker auth
# X402_RECIPIENT="0x..."                 # Base Sepolia recipient (Phase 3); NEVER leave at the zero address
# CHECK_SIGNING_SECRET="..."             # HMAC over the verdicts /api/check issues, so
#                                        # /api/capture can prove it issued them. Any long
#                                        # random string. Absent means the free checker still
#                                        # works and capture refuses every verdict, which is
#                                        # the intended failure: the tool stays up, the write
#                                        # path fails closed.
# RESEND_API_KEY="..."                   # transactional email. Absent means a capture is
#                                        # recorded and no read is sent.
# RESEND_FROM="Legibility <hello@legibility.io>"  # sender; must be a verified Resend domain
# RESEND_REPLY_TO="krish@mindmake.co"  # where replies land. Separate from the sender
#                                        # because the sending domain is a deliverability
#                                        # constraint and the reply address is a person.
# STRIPE_SECRET_KEY="..."                # billing (post-beta)
# STRIPE_WEBHOOK_SECRET="..."            # billing webhook signature (post-beta)
# GROWTH_EXPORT_TOKEN_SHA256="..."      # A4: the lowercase hex SHA-256 of the growth engine's
#                                        # export token. The app never holds the token itself.
#                                        # Absent means GET /api/internal/growth/export answers 401
#                                        # to everyone; replacing it revokes the old token.
# EXPORT_ID_KEY="..."                    # A4: HMAC key for the export's opaque ids (at least 32
#                                        # characters, random). Rotating it changes every id and
#                                        # breaks returning counts, so only with Krish's yes.
# MCP_CONTACT_EMAIL="..."                # A6: the role address on the legibility.io domain that
#                                        # /.well-known/mcp.json publishes as its contact. Anything
#                                        # not on legibility.io is ignored and no contact is shown.
# MCP_REGISTRY_AUTH_PUBLIC_KEY="..."     # A7: base64 ed25519 PUBLIC key the MCP Registry checks at
#                                        # /.well-known/mcp-registry-auth when Krish publishes
#                                        # server.json. Not a secret; 404 until set.
