{
  "name": "Legibility",
  "short_name": "Legibility",
  "description": "Can a machine read your website? Legibility shows what an AI crawler sees and records why when it cannot read a page.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#F4EFE6",
  "theme_color": "#0E1B2C",
  "icons": [
