# Legibility environment. Copy to .env and fill in. NEVER commit .env (gitignored).

# --- Client + SSR (public, RLS-gated; safe to expose) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# --- Server-only secrets (set in Vercel project env, never in the client bundle) ---
# SUPABASE_SERVICE_ROLE_KEY="..."        # writes to usage_events/resolutions/product_cache; bypasses RLS
# LEGIBILITY_EXTRACTOR_URL="https://..."     # standalone extraction worker (Phase 1)
# LEGIBILITY_EXTRACTOR_TOKEN="..."           # worker auth
# X402_RECIPIENT="0x..."                 # Base Sepolia recipient (Phase 3); NEVER leave at the zero address
# X402_NETWORK="base-sepolia"            # x402 network, default base-sepolia. Setting "base" asks for
#                                        # Base mainnet: that is the mainnet switch, and it is off.
#                                        # Change it only with X402_ASSET and with Krish's yes.
# X402_FACILITATOR="https://x402.org/facilitator"  # verify-and-settle service (the default)
# X402_ASSET="0x..."                     # USDC contract; default is USDC on Base Sepolia
# X402_PRICE_ATOMIC="10000"              # price a call in atomic USDC (6 decimals); default 0.01
# APP_BASE_URL="https://legibility.io"   # optional: the base for Stripe checkout and portal return
#                                        # links. Unset means APP_ORIGIN in src/config/product.ts.
# VERCEL_GIT_COMMIT_SHA                  # set by Vercel itself, not by hand. The growth export's
#                                        # app_revision reads it, and says "unknown" without it.
# CHECK_SIGNING_SECRET="..."             # HMAC over the verdicts /api/check issues, so
#                                        # /api/capture can prove it issued them. Any long
#                                        # random string. Absent means the free checker still
#                                        # works and capture refuses every verdict, which is
#                                        # the intended failure: the tool stays up, the write
#                                        # path fails closed.
# RESEND_API_KEY="..."                   # transactional email. Absent means a capture is
#                                        # recorded and no read is sent.
# RESEND_FROM="Legibility <sender@your-verified-domain>"  # sender; must be on a verified
#                                        # Resend domain. Unset, the code uses its own default.
# RESEND_REPLY_TO="role@your-domain"     # where replies land: a role address on legibility.io,
#                                        # never a person's own. Separate from the sender because
#                                        # the sending domain is a deliverability constraint.
# STRIPE_SECRET_KEY="..."                # billing (post-beta)
# STRIPE_WEBHOOK_SECRET="..."            # billing webhook signature (post-beta)
# GROWTH_EXPORT_TOKEN_SHA256="..."      # A4: the lowercase hex SHA-256 of the growth engine's
#                                        # export token. The app never holds the token itself.
#                                        # Absent means GET /api/internal/growth/export answers 401
#                                        # to everyone; replacing it revokes the old token. Today
#                                        # it is the hash of the engine's Control Center bearer, so
#                                        # rotating that bearer breaks the export: see
#                                        # docs-internal/ops.md, "Growth export token".
# EXPORT_ID_KEY="..."                    # A4: HMAC key for the export's opaque ids (at least 32
#                                        # characters, random). Rotating it changes every id and
#                                        # breaks returning counts, so only with Krish's yes. It
#                                        # also keys the Founding 200 IP hash, so rotating it
#                                        # resets every per-IP daily limit.
# MCP_CONTACT_EMAIL="..."                # A6: the role address on the legibility.io domain that
#                                        # /.well-known/mcp.json publishes as its contact. Anything
#                                        # not on legibility.io is ignored and no contact is shown.
#                                        # It is also the address the Founding 200 page offers a
#                                        # call through; unset, no call is offered.
# MCP_REGISTRY_AUTH_PUBLIC_KEY="..."     # A7: base64 ed25519 PUBLIC key the MCP Registry checks at
#                                        # /.well-known/mcp-registry-auth when Krish publishes
#                                        # server.json. Not a secret; 404 until set.
# TURNSTILE_SITE_KEY="..."               # A3: Cloudflare Turnstile site key (public) for the
#                                        # Founding 200 page's bot challenge. Absent means the
#                                        # test is shown as paused.
# TURNSTILE_SECRET_KEY="..."             # A3: Turnstile secret, checked server-side on every
#                                        # run. Absent means every run is refused (fail closed).
#                                        # The page's limits also need EXPORT_ID_KEY (the IP hash).
# FOUNDING_AUTO_TRIAL="false"            # A8: "true" gives every new Founding 200 key the default
#                                        # 30-day trial (5,000 trusted reads, fuse from the measured
#                                        # cost). Off by default: trials are Krish's click on
#                                        # /dashboard/waitlist, Trials. The page's offer follows
#                                        # this flag (offerText in src/lib/api/founding.ts), so
#                                        # it states 5,000 reads only while a new key gets them.
